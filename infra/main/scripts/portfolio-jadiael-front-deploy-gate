#!/bin/bash
set -Eeuo pipefail

case "${SSH_ORIGINAL_COMMAND:-}" in
    ping)
        echo "Jadiael Front SSH authentication OK"
        ;;

    "deploy "*)
        SHA="${SSH_ORIGINAL_COMMAND#deploy }"

        if [[ ! "$SHA" =~ ^[0-9a-f]{40}$ ]]; then
            echo "Invalid commit SHA." >&2
            exit 1
        fi

        printf '%s\n' "$SHA" |
            sudo -n /usr/local/sbin/deploy-portfolio-jadiael-front
        ;;

    *)
        echo "Command not allowed." >&2
        exit 1
        ;;
esac
